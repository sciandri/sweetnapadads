{
  "name": "sweet-looking-napa-dads",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "db:lint": "supabase db lint --local --level warning --fail-on warning",
    "db:reset": "supabase db reset --local",
    "db:start": "supabase start",
    "db:status": "supabase status",
    "db:stop": "supabase stop",
    "db:test": "supabase test db",
    "start": "next start",
    "lint": "eslint .",
    "import:2025:rehearse": "node scripts/rehearse-2025-import.mjs",
    "tracking:check": "node scripts/check-tracking.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.111.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "supabase": "2.110.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "minimatch": "10.2.6",
